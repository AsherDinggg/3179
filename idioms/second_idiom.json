{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": null,
    "width": "container",
    "height": 550,
    "data": {
        "url": "data/second_idiom.csv"
    },
    "transform": [
        {
            "fold": [
                "Female Participation Rate (%)",
                "Male Participation Rate (%)"
            ],
            "as": ["Gender", "Participation Rate (%)"]
        },
        {
            "calculate": "datum.Gender === 'Female Participation Rate (%)' ? 'Female' : 'Male'",
            "as": "Gender"
        }, 
        {
            "calculate": "format(datum['Participation Rate (%)'], '.1f') + '%'",
            "as": "Participation Label"
        }
    ],
    "layer": [
        {
            "mark": {
                "type": "line",
                "strokeWidth": 3,
                "color": "#918686"
            },
            "encoding": {
                "y": {
                    "field": "Age Group",
                    "type": "ordinal",
                    "sort": [
                        "65+",
                        "55-64",
                        "45-54",
                        "35-44",
                        "25-34",
                        "18-24",
                        "15-17"
                    ],
                    "title": "Age group"
                },
                "x": {
                    "field": "Participation Rate (%)",
                    "type": "quantitative",
                    "title": "Participation rate (%)"
                },
                "detail": {
                    "field": "Age Group"
                }
            }
        },
        {
            "mark": {
                "type": "point",
                "filled": true,
                "size": 200,
                "opacity": 1
            },
            "encoding": {
                "y": {
                    "field": "Age Group",
                    "type": "ordinal",
                    "sort": [
                        "65+",
                        "55-64",
                        "45-54",
                        "35-44",
                        "25-34",
                        "18-24",
                        "15-17"
                    ],
                    "title": "Age group",
                    "axis": {
                                "labelFontSize": 14,
                                "titleFontSize": 17
                            }                    
                },
                "x": {
                    "field": "Participation Rate (%)",
                    "type": "quantitative",
                    "title": "Participation rate (%)",
                    "axis": {
                                "labelFontSize": 14,
                                "titleFontSize": 17,
                                "grid": true
                            }
                },
                "color": {
                    "field": "Gender",
                    "type": "nominal",
                    "scale": {
                        "domain": ["Female", "Male"],
                        "range": ["#4B3621", "#264025"]
                    },
                    "title": "Gender",
                    "legend": {
                        "orient": "top-right",
                        "offset": 10,
                        "padding": 12,
                        "titleFontSize": 18,
                        "titleColor": "#141414",
                        "labelColor": "#262524",
                        "labelFontSize": 14,
                        "symbolSize": 180,
                        "labelOffset": 8,
                        "fillColor": "#e6eae5",
                        "strokeColor": "#3738369c",
                        "cornerRadius": 3
                    }
                },
                "tooltip": [
                    {
                        "field": "Age Group",
                        "type": "ordinal",
                        "title": "Age group"
                    },
                    {
                        "field": "Gender",
                        "type": "nominal"
                    },
                    {
                        "field": "Participation Rate (%)",
                        "type": "quantitative",
                        "title": "Participation rate (%)",
                        "format": ".1f"
                    }
                ]
            }
        },
        {
            "mark": {
                "type": "text",
                "dy": 14,
                "fontSize": 10,
                "fontWeight": "bold",
                "color": "#262524",
                "align": "center",
                "baseline": "top"
            },
            "encoding": {
                "y": {
                    "field": "Age Group",
                    "type": "ordinal",
                    "sort": [
                        "65+",
                        "55-64",
                        "45-54",
                        "35-44",
                        "25-34",
                        "18-24",
                        "15-17"
                    ]
                },
                "x": {
                    "field": "Participation Rate (%)",
                    "type": "quantitative"
                },
                "text": {
                    "field": "Participation Label",
                    "type": "nominal"
                }
            }
        }
    ],
    "config": {
        "background": "#cccfcb",
        "view": {
            "stroke": null
        }
    }
}