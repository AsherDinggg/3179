{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": null,
    "width": "container",
    "height": 550,
    "data": {
        "url": "data/eight_idiom.csv"
    },
    "transform": [
        {
            "calculate": "datum['Waterfall Type'] === 'Baseline' ? 'Baseline' : datum['Waterfall Value'] >= 0 ? 'Increase' : 'Decrease'",
            "as": "Change Category"
        }
    ],
    "mark": {
        "type": "bar",
        "tooltip": true
    },
    "encoding": {
        "x": {
            "field": "Year",
            "type": "ordinal",
            "sort": "ascending",
            "title": "Year",
            "axis": {
                        "labelFontSize": 14,
                        "titleFontSize": 17,
                        "grid": false
                    }
        },
        "y": {
            "field": "Waterfall Start",
            "type": "quantitative",
            "title": "Average performances per event",
            "scale": {
                "domain": [0, 650]
            },
            "axis": {
                        "labelFontSize": 14,
                        "titleFontSize": 17,
                        "grid": true
                    }
        },
        "y2": {
            "field": "Waterfall End"
        },
        "color": {
            "field": "Change Category",
            "type": "nominal",
            "scale": {
                "domain": ["Baseline", "Increase", "Decrease"],
                "range": ["#596B75", "#E69F00", "#8064A2"]
            },
            "legend": {
                "title": "Year-on-year change",
                "orient": "bottom",
                "direction": "horizontal",
                "padding": 12,
                "titleFontSize": 16,
                "titleColor": "#141414",
                "labelColor": "#262524",
                "labelFontSize": 12,
                "symbolSize": 180,
                "labelOffset": 5,
                "fillColor": "#e6eae5",
                "strokeColor": "#3738369c",
                "cornerRadius": 3
            }
        },
        "tooltip": [
            {
                "field": "Year",
                "type": "ordinal"
            },
            {
                "field": "Average Performances per Event",
                "type": "quantitative",
                "title": "Average performances per event",
                "format": ".1f"
            },
            {
                "field": "Waterfall Value",
                "type": "quantitative",
                "title": "Change from previous year",
                "format": "+.1f"
            }
        ]
    },
    "config": {
        "background": "#cccfcb",
        "view": {
            "stroke": null
        }
    }
}