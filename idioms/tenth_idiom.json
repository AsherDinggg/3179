{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": null,
    "data": {
        "url": "data/tenth_idiom.csv"
    },
    "facet": {
        "field": "Month",
        "type": "ordinal",
        "sort": [
            "January", "February", "March", "April",
            "May", "June", "July", "August",
            "September", "October", "November", "December"
        ],
        "header": {
            "title": null,
            "labelFontSize": 14,
            "labelFontWeight": "bold"
        }
    },
    "columns": 3,
    "spec": {
        "width": 315,
        "height": 220,
        "mark": {
                "type": "rect",
                "stroke": "white",
                "strokeWidth": 1
            },
            "encoding": {
                "x": {
                    "field": "Weekday",
                    "type": "ordinal",
                    "sort": [
                        "Monday", "Tuesday", "Wednesday", "Thursday",
                        "Friday", "Saturday", "Sunday"
                    ],
                    "axis": {
                        "title": null,
                        "labelAngle": -45,
                        "labelFontSize": 11,
                        "labelLimit": 63,
                        "labelOverlap": false,
                        "ticks": false,
                        "domain": false,
                        "labelFontWeight":"bold"
                    }
                },
                "y": {
                    "field": "Week of Month",
                    "type": "ordinal",
                    "sort": [1,2,3,4,5],
                    "axis": {
                        "title": null,
                        "labelFontSize": 13,
                        "ticks": false,
                        "domain": false,
                        "labelPadding": 10,
                        "labelFontWeight": "bold"
                    }
                },
                "color": {
                    "field": "Event Count",
                    "type": "quantitative",
                    "scale": {
                        "range": ["#FFF3CF", "#F3D98B", "#D9B45B", "#A98232"]
                    },
                    "legend": {
                        "title": "Events",
                        "orient": "bottom",
                        "direction": "horizontal",
                        "offset": 10,
                        "padding": 8,
                        "titleFontSize": 16,
                        "titleColor": "#141414",
                        "labelColor": "#262524",
                        "labelFontSize": 12,
                        "fillColor": "#e6eae5",
                        "strokeColor": "#3738369c",
                        "cornerRadius": 3,
                        "gradientLength": 140,
                        "gradientThickness": 17
                    }
                },
                "tooltip": [
                    {
                        "field": "Date",
                        "type": "nominal",
                        "title": "Date"
                    },
                    {
                        "field": "Event Count",
                        "type": "quantitative",
                        "title": "Number of events"
                    },
                    {
                        "field": "Event Names",
                        "type": "nominal",
                        "title": "Event names",
                        "format": ""
                    }
                ]
            }
        },
        "config": {
            "background": "#cccfcb",
            "view": {
                "stroke": null
            },
            "axis": {
                "grid": false
            },
            "facet": {
                "spacing": 18
            }
        }
    }