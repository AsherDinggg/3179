{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": null,
    "width": "container",
    "height": 700,
    "data": {
        "values": []
    },
    "transform": [
        {
            "calculate": "datum.Sport === 'Running/Jogging'",
            "as": "isRunning"
        }
    ],
    "layer": [
        {
            "mark": {
                "type": "rect",
                "stroke": "#ffffff",
                "strokeWidth": 1
            },
            "encoding": {
                "x": {
                    "field": "x0",
                    "type": "quantitative",
                    "scale": {"domain": [0,1]},
                    "axis": null
                },
                "x2": {
                    "field": "x1"
                },
                "y": {
                    "field": "y1",
                    "type": "quantitative",
                    "scale": {"domain": [1,0]},
                    "axis": null
                },
                "y2": {
                    "field": "y0"
                },
                "color": {
                    "condition": {
                        "test": "datum.isRunning",
                        "value": "#76618B"
                    },
                    "value": "#C8BED2"
                },
                "tooltip": [
                    {
                        "field": "Age_Group",
                        "type": "nominal",
                        "title": "Age group"
                    },
                    {
                        "field": "Sport",
                        "type": "nominal",
                        "title": "Sport"
                    },
                    {
                        "field": "Estimated_Participants",
                        "type": "quantitative",
                        "title": "Estimated participants",
                        "format": ","
                    },
                    {
                        "field": "Share_Within_Selected_Sports",
                        "type": "quantitative",
                        "title": "Share within selected sports",
                        "format": ".1%"
                    }
                ]
            }
        },
        {
            "transform": [
                {
                    "filter": "datum.Share_Within_Selected_Sports >= 0.12"
                }
            ],
            "mark": {
                "type": "text",
                "fontSize": 12,
                "fontWeight": "bold",
                "align": "center",
                "baseline": "middle",
                "lineBreak": "\n"
            },
            "encoding": {
                "x": {
                    "field": "xCenter",
                    "type": "quantitative",
                    "scale": {"domain": [0,1]},
                    "axis": null
                },
                "y": {
                    "field": "yCenter",
                    "type": "quantitative",
                    "scale": {"domain": [1,0]},
                    "axis": null
                },
                "text": {
                    "field": "label",
                    "type": "nominal"
                },
                "color": {
                    "condition": {
                        "test": "datum.isRunning",
                        "value": "#ffffff"
                    },
                    "value": "#17231d"
                }
            }
        },
        {
            "transform": [
                {
                    "aggregate": [
                        {
                            "op": "mean",
                            "field": "xCenter",
                            "as": "xCenter"
                        }
                    ],
                    "groupby": ["Age_Group"]
                }
            ],
            "mark": {
                "type": "text",
                "fontSize": 12,
                "fontWeight":"bold",
                "dy": -8,
                "baseline": "bottom",
                "color": "#17231d"
            },
            "encoding": {
                "x": {
                    "field": "xCenter",
                    "type": "quantitative",
                    "scale": {"domain": [0,1]},
                    "axis": null
                },
                "y": {
                    "value": 0
                },
                "text": {
                    "field": "Age_Group",
                    "type": "nominal"
                }
            }
        }
    ],
    "config": {
        "view": {
            "stroke": null
        }
    }
}