                    }
                ]
            },
            "mark": {
                "type": "rule",
                "stroke": "#17231d",
                "strokeWidth": 1.5
            },
            "encoding": {
                "longitude": {
                    "field": "longitude",
                    "type": "quantitative"
                },
                "latitude": {
                    "field": "latitude",
                    "type": "quantitative"
                },
                "longitude2": {
