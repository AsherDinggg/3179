{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": null,
    "width": "container",
    "height": 550,
    "projection": {
        "type": "mercator",
        "center": [134, -27],
        "scale": 750
    },
    "layer": [
        {
            "data": {
                "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
                "format": {
                    "type": "json",
                    "property": "features"
                }
            },
            "transform": [
                {
                    "lookup": "properties.STATE_NAME",
                    "from": {
                        "data": {
                            "url": "data/fifth_idiom.csv"
                        },
                        "key": "State",
                        "fields": [
                            "Participants",
                            "Participation Rate (%)"
                        ]
                    }
                }
            ],
            "mark": {
                "type": "geoshape",
                "stroke": "#ffffff",
                "strokeWidth": 1
            },
            "encoding": {
                "color": {
                    "field": "Participation Rate (%)",
                    "type": "quantitative",
                    "title": "Participation rate (%)",
                    "scale": {
                        "range": ["#D5E5E7", "#91BEC3", "#4F929C", "#28616B"]
                    },
                    "legend": {
                        "orient": "bottom-left",
                        "direction": "horizontal",
                        "offset": 10,
                        "padding": 12,
                        "titleFontSize": 16,
                        "titleColor": "#141414",
                        "labelColor": "#262524",
                        "labelFontSize": 12,
                        "symbolSize": 180,
                        "labelOffset": 8,
                        "fillColor": "#e6eae5",
                        "strokeColor": "#3738369c",
                        "cornerRadius": 3,
                        "gradientLength": 165
                    }
                },
                "tooltip": [
                    {
                        "field": "properties.STATE_NAME",
                        "type": "nominal",
                        "title": "State/Territory"
                    },
                    {
                        "field": "Participation Rate (%)",
                        "type": "quantitative",
                        "title": "Participation rate (%)",
                        "format": ".1f"
                    }
                ]
            }
        },
        {
            "data": {
                "values": [
                    {
                        "longitude": 149.13,
