{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": null,
    "width": "container",
    "height": 573,
    "projection": {
        "type": "mercator",
        "center": [134, -27],
        "scale": 750
    },
    "layer": [
        {
            "data": {
                "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
                "format": {
                    "type": "json",
                    "property": "features"
                }
            },
            "mark": {
                "type": "geoshape",
                "fill": "#eeeeee",
                "stroke": "#ffffff",
                "strokeWidth": 0.9
            }
        },
        {
            "data": {
                "url": "data/sixth_idiom.csv",
                "format": {
                    "type": "csv"
                }
            },
            "mark": {
                "type": "circle",
                "opacity": 0.68,
                "stroke": "#373836",
                "strokeWidth": 1.2,
                "color": "#E8A0BF"
            },
            "encoding": {
                "longitude": {
                    "field": "longitude",
                    "type": "quantitative"
                },
                "latitude": {
                    "field": "latitude",
                    "type": "quantitative"
                },
                "size": {
                    "field": "Total_Offerings",
                    "type": "quantitative",
                    "scale": {
                        "zero": true,
                        "range": [100, 1800]
                    },
                    "legend": {
                        "title": "Event-distance offerings",
                        "orient": "top-right",
                        "direction": "vertical",
                        "offset": 10,
                        "padding": 12,
                        "titleFontSize": 16,
                        "titleColor": "#141414",
                        "labelColor": "#262524",
                        "labelFontSize": 12,
                        "symbolSize": 180,
                        "labelOffset": 8,
                        "fillColor": "#e6eae5",
                        "strokeColor": "#3738369c",
                        "cornerRadius": 3
                    }
                },
                "tooltip": [
                    {
                        "field": "State_Territory",
                        "type": "nominal",
                        "title": "State/Territory"
                    },
                    {
                        "field": "Total_Offerings",
                        "type": "quantitative",
                        "title": "Total offerings",
                        "format": ","
                    },
                    {
                        "field": "Under_5_km",
                        "type": "quantitative",
                        "title": "Under 5 km",
                        "format": ","
                    },
                    {
                        "field": "5_km",
                        "type": "quantitative",
                        "title": "5 km",
                        "format": ","
                    },
                    {
                        "field": "10_km",
                        "type": "quantitative",
                        "title": "10 km",
                        "format": ","
                    },
                    {
                        "field": "Half_marathon",
                        "type": "quantitative",
                        "title": "Half marathon (21.1 km)",
                        "format": ","
                    },
                    {
                        "field": "Marathon",
                        "type": "quantitative",
                        "title": "Marathon (42.2 km)",
                        "format": ","
                    },
                    {
                        "field": "Other_distance",
                        "type": "quantitative",
                        "title": "Other distances",
                        "format": ","
                    }
                ]
            }
        }
    ],
    "config": {
        "background": "#cccfcb",
        "view": {
            "stroke": null
        }
    }
}