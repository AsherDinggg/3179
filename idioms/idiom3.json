{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": null,
    "width": "container",
    "height": 550,
    "data": {
        "url": "data/idiom_3.csv"
    },
    "transform": [
        {
            "fold": [
                "Female Participation Rate (%)",
                "Male Participation Rate (%)"
            ],
            "as": ["Gender", "Participation Rate (%)"]
        },
        {
            "calculate": "datum.Gender === 'Female Participation Rate (%)' ? 'Female' : 'Male'",
            "as": "Gender"
        }
    ],
    "layer": [
        {
            "mark": {
                "type": "line",
                "strokeWidth": 2,
                "color": "#bdbdbd"
            },
            "encoding": {
                "y": {
                    "field": "Age Group",
                    "type": "ordinal",
                    "sort": [
                        "65+",
                        "55-64",
                        "45-54",
                        "35-44",
                        "25-34",
                        "18-24",
                        "15-17"
                    ],
                    "title": "Age group"
                },
                "x": {
                    "field": "Participation Rate (%)",
                    "type": "quantitative",
                    "title": "Participation rate (%)"
                },
                "detail": {
                    "field": "Age Group"
                }
            }
        },
        {
            "mark": {
                "type": "point",
                "filled": true,
                "size": 100
            },
            "encoding": {
                "y": {
                    "field": "Age Group",
                    "type": "ordinal",
                    "sort": [
                        "65+",
                        "55-64",
                        "45-54",
                        "35-44",
                        "25-34",
                        "18-24",
                        "15-17"
                    ],
                    "title": "Age group"
                },
                "x": {
                    "field": "Participation Rate (%)",
                    "type": "quantitative",
                    "title": "Participation rate (%)"
                },
                "color": {
                    "field": "Gender",
                    "type": "nominal",
                    "scale": {
                        "domain": ["Female", "Male"],
                        "range": ["#C67A65", "#245747"]
                    },
                    "title": "Gender"
                },
                "tooltip": [
                    {
                        "field": "Age Group",
                        "type": "ordinal",
                        "title": "Age group"
                    },
                    {
                        "field": "Gender",
                        "type": "nominal"
                    },
                    {
                        "field": "Participation Rate (%)",
                        "type": "quantitative",
                        "title": "Participation rate (%)",
                        "format": ".1f"
                    }
                ]
            }
        }
    ],
    "config": {
        "view": {
            "stroke": null
        }
    }
}