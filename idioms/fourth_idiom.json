{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": null,
    "width": "container",
    "height": 600,
    "data": {
        "url": "data/fourth_idiom.csv"
    },
    "mark": {
                "type": "rect",
                "strokeWidth": 2,
                "color": "white"
            },
    "encoding": {
        "y": {
            "field": "Age Group",
            "type": "ordinal",
            "sort": [
                "65+",
                "55-64",
                "45-54",
                "35-44",
                "25-34",
                "18-24",
                "15-17"
                    ],
            "title": "Age group",
            "axis": {
                        "labelFontSize": 14,
                        "titleFontSize": 17,
                        "grid": false
                    }
        },
        "x": {
            "field": "Motivation",
            "type": "nominal",
            "title": "Motivation",
            "axis": {
                "labelAngle": -35,
                "labelLimit": 180,
                "labelFontSize": 14,
                "titleFontSize": 17,
                "grid": false
            }
        },
        "color": {
            "field": "Percentage",
            "type": "quantitative",
            "title": "Percentage (%)",
            "scale": {
                "range": ["#E3EBDD", "#A9C5A5", "#568875", "#245747"]
            },
            "legend": {
                "orient": "bottom",
                "padding": 10,
                "direction": "horizontal",
                "titleFontSize": 16,
                "titleColor": "#141414",
                "labelColor": "#262524",
                "labelFontSize": 10,
                "labelOffset": 8,
                "fillColor": "#e6eae5",
                "strokeColor": "#3738369c",
                "cornerRadius": 3
            }
        },
        "tooltip": [
            {
                "field": "Age Group",
                "type": "ordinal",
                "title": "Age group"
            },
            {
                "field": "Motivation",
                "type": "nominal",
                "title": "Motivation"
            },
            {
                "field": "Percentage",
                "type": "quantitative",
                "title": "Percentage (%)",
                "format": ".1f"
            }
        ]
    },
    "config": {
        "background": "#cccfcb",
        "view": {
            "stroke": null
        }
    }
}