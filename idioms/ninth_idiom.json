{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": null,
    "width": "container",
    "height": 573,
    "projection": {
        "type": "mercator",
        "center": [134, -27],
        "scale": 750
    },
    "layer": [
        {
            "data": {
                "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
                "format": {
                    "type": "json",
                    "property": "features"
                }
            },
            "mark": {
                "type": "geoshape",
                "fill": "#eeeeee",
                "stroke": "#ffffff",
                "strokeWidth": 0.9
            }
        },
        {
            "data": {
                "url": "data/ninth_idiom.csv",
                "format": {
                    "type": "csv"
                }
            },
            "mark": {
                "type": "circle",
                "opacity": 0.5,
                "stroke": "#0d0606",
                "strokeWidth": 1.5
            },
            "encoding": {
                "longitude": {
                    "field": "longitude",
                    "type": "quantitative"
                },
                "latitude": {
                    "field": "latitude",
                    "type": "quantitative"
                },
                "size": {
                    "field": "Finishers (2025)",
                    "type": "quantitative",
                    "scale": {
                        "domain": [20000, 75000],
                        "range": [150, 1400]
                    },
                    "legend": {
                        "title": "2025 finishers",
                        "orient": "top-right",
                        "direction": "vertical",
                        "offset": 10,
                        "padding": 12,
                        "titleFontSize": 16,
                        "titleColor": "#141414",
                        "labelColor": "#262524",
                        "labelFontSize": 12,
                        "symbolSize": 180,
                        "labelOffset": 8,
                        "fillColor": "#e6eae5",
                        "strokeColor": "#3738369c",
                        "cornerRadius": 3
                    }
                },
                "color": {
                    "field": "Finishers Amount Change from 2024 (%)",
                    "type": "quantitative",
                    "scale": {
                        "domain": [-10, 0, 50],
                        "range": ["#75609A", "#E8DCC8", "#C66A3D"]
                    },
                    "legend": {
                        "title": "Change from 2024 (%)",
                        "orient": "top-right",
                        "direction": "horizontal",
                        "offset": 10,
                        "padding": 8,
                        "titleFontSize": 13,
                        "titleColor": "#141414",
                        "labelColor": "#262524",
                        "labelFontSize": 11,
                        "fillColor": "#e6eae5",
                        "strokeColor": "#3738369c",
                        "cornerRadius": 3,
                        "gradientLength": 140,
                        "gradientThickness": 17
                    }
                },
                "tooltip": [
                    {
                        "field": "Event Name",
                        "type": "nominal",
                        "title": "Event"
                    },
                    {
                        "field": "State/Territory",
                        "type": "nominal",
                        "title": "State/Territory"
                    },
                    {
                        "field": "Finishers (2025)",
                        "type": "quantitative",
                        "title": "2025 finishers",
                        "format": ","
                    },
                    {
                        "field": "Finishers Amount Change from 2024 (%)",
                        "type": "quantitative",
                        "title": "Change from 2024 (%)",
                        "format": "+.1f"
                    }
                ]
            }
        }
    ],
    "config": {
        "background": "#cccfcb",
        "view": {
            "stroke": null
        }
    }
}